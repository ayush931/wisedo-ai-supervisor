            "citation_support_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "exact_quantities_units_time_rate": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "abstention_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "unauthorized_disclosure_or_effect_max": {
              "type": "integer",
              "minimum": 0
            },
            "interactive_p95_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "concurrent_users": {
              "type": "integer",
              "minimum": 0
            },
            "hard_deadline_seconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "verbatim": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
