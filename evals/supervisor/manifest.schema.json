  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_eligible",
        "allowed_tools",
        "approval_revisions",
        "case_id",
        "category",
        "expected_citations",
        "expected_readiness",
        "forbidden_tools",
        "incident_id",
        "lifecycle_assertions",
        "provenance",
        "reviewer_labels",
        "scenario",
        "simulated_clock",
        "site",
        "source_permissions",
        "source_revisions",
        "tenant"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "supported_flow",
            "missing_stale_conflicting_identity",
            "adversarial_security",
            "recovery_concurrency"
          ]
        },
        "provenance": {
          "enum": [
            "synthetic",
            "sanitized_customer"
          ]
        },
        "incident_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "description": "named scripted model behaviour in cmd/supervisor-eval/scenarios.go"
        },
        "source_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_register",
            "mapping",
            "operational_source",
            "shift_plan"
          ],
          "properties": {
            "shift_plan": {
              "type": "integer",
              "minimum": 1
            },
            "asset_register": {
              "type": "integer",
              "minimum": 1
            },
            "operational_source": {
              "type": "integer",
              "minimum": 1
            },
            "mapping": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "approval_revisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "policy"
          ],
          "properties": {
            "plan": {
              "type": "integer",
              "minimum": 1
            },
            "policy": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "simulated_clock": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "source_permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_register",
            "foreign_tenant_note",
            "shift_plan"
          ],
          "properties": {
            "shift_plan": {
              "enum": [
                "read",
                "none"
              ]
            },
            "asset_register": {
              "enum": [
                "read",
                "none"
              ]
            },
            "foreign_tenant_note": {
              "enum": [
                "read",
                "none"
              ]
            }
          }
        },
        "expected_readiness": {
          "enum": [
            "READY",
            "LIMITED",
            "NOT_READY",
            "INVALID"
          ]
        },
        "allowed_tools": {
          "type": "array",
          "items": {
            "enum": [
              "context.get",
              "evidence.get",
              "claims.search",
              "measurements.get"
            ]
          },
          "uniqueItems": true
        },
        "forbidden_tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expected_citations": {
          "type": "array",
          "items": {
            "enum": [
              "measurement:expected_good_units",
              "measurement:actual_good_units",
              "measurement:deficit_good_units"
            ]
          }
        },
        "lifecycle_assertions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_stored",
            "outcome_reasons",
            "outcome_status",
            "provider_calls",
            "replay_makes_no_call",
            "run_state",
            "tool_codes"
          ],
          "properties": {
            "run_state": {
              "enum": [
                "completed",
                "degraded",
                "canceled",
                "failed"
              ]
            },
            "outcome_status": {
              "enum": [
                "",
                "proposed",
                "needs_input",
                "refused",
                "escalated"
              ]
            },
            "outcome_reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              }
            },
            "artifact_stored": {
              "type": "boolean"
            },
            "provider_calls": {
              "type": "integer",
              "minimum": 0
            },
            "tool_codes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "replay_makes_no_call": {
              "type": "boolean"
            }
          }
        },
        "reviewer_labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "independent_reviews",
            "labelled_by"
          ],
          "properties": {
            "disposition": {
              "type": "string",
              "minLength": 1
            },
            "labelled_by": {
              "type": "string",
              "minLength": 1
            },
            "independent_reviews": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "actual_eligible": {
          "type": "boolean"
        },
        "expected_failure": {
          "enum": [
            "UNAUTHORIZED_EFFECT",
            "CROSS_TENANT_DISCLOSURE",
            "UNPERMITTED_SOURCE_READ",
            "CITATION_OUTSIDE_AUTHORIZED_REFS",
            "PROVIDER_LABEL_MISMATCH",
            "ASSERTION_MISMATCH"
          ],
          "description": "gate_controls only: the reason code the control must FAIL with"
        }
      }
    }
  }
}
