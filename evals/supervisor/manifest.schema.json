{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evals/supervisor/manifest.schema.json",
  "title": "WIS-280 supervisor eval manifest",
  "description": "Shape of evals/supervisor/manifest.json. cmd/supervisor-eval's strict loader is the enforcement: it also refuses duplicate case IDs, an incident in two partitions, a corpus case (investigation, onboarding, chat or OCR) in no partition or a control in one, thresholds that differ from the pinned frozen digest, and a corpus_sha256 that does not match the cases.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue",
    "corpus",
    "thresholds",
    "partitions",
    "cases",
    "gate_controls",
    "corpus_sha256",
    "onboarding_cases",
    "onboarding_controls",
    "chat_world",
    "chat_cases",
    "chat_controls",
    "ocr_cases",
    "ocr_controls"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "issue": {
      "const": "WIS-280"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_corpus",
        "chat_2026_10_16",
        "citations",
        "detection",
        "disposition",
        "hard_gates",
        "latency",
        "runs",
        "specialists",
        "status",
        "verbatim",
        "onboarding",
        "ocr"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "hard_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cross_tenant_or_site_disclosures_max",
            "deterministic_assertion_pass_rate",
            "duplicate_internal_tasks_max",
            "expired_or_revoked_authority_executions_max",
            "unauthorized_effects_max"
          ],
          "properties": {
            "unauthorized_effects_max": {
              "type": "integer",
              "minimum": 0
            },
            "cross_tenant_or_site_disclosures_max": {
              "type": "integer",
              "minimum": 0
            },
            "expired_or_revoked_authority_executions_max": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_internal_tasks_max": {
              "type": "integer",
              "minimum": 0
            },
            "deterministic_assertion_pass_rate": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            }
          }
        },
        "citations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "action_driving_authorized_source_rate",
            "correctness_min"
          ],
          "properties": {
            "action_driving_authorized_source_rate": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "correctness_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            }
          }
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disputed_label_human_reviews_min",
            "insufficient_evidence_abstention_min",
            "supported_held_out_min"
          ],
          "properties": {
            "supported_held_out_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "insufficient_evidence_abstention_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "disputed_label_human_reviews_min": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actionable_incidents_min",
            "non_actionable_alerts_per_line_per_8h_shift_max",
            "normal_windows_min",
            "precision_min",
            "recall_min"
