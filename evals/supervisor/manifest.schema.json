          "properties": {
            "actionable_incidents_min": {
              "type": "integer",
              "minimum": 0
            },
            "normal_windows_min": {
              "type": "integer",
              "minimum": 0
            },
            "recall_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "precision_min": {
              "type": "string",
              "pattern": "^(0|1)(\\.[0-9]{1,6})?$"
            },
            "non_actionable_alerts_per_line_per_8h_shift_max": {
              "type": "integer",
              "minimum": 0
            }
          }
