          "properties": {
            "completeness_eligibility_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "context_to_case_p95_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "investigation_p95_seconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "runs": {
          "type": "object",
