{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "format": "uuid",
            "type": "string"
          },
          "content": {
            "additionalProperties": false,
            "properties": {
              "claim": {
                "additionalProperties": false,
                "properties": {
                  "claim_id": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "string"
                  },
                  "effective_from": {
                    "type": "string"
                  },
                  "effective_to": {
                    "type": "string"
                  },
                  "evidence_class": {
                    "type": "string"
                  },
                  "extractor": {
                    "additionalProperties": false,
                    "properties": {
                      "model": {
                        "type": "string"
                      },
                      "prompt_sha256": {
                        "type": "string"
                      },
                      "provider": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "model",
                      "prompt_sha256",
                      "provider",
                      "version"
                    ],
                    "type": "object"
                  },
                  "literal": {
                    "additionalProperties": false,
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "unit": {
                        "type": "string"
                      },
                      "value": {
                        "description": "Any JSON value"
                      }
                    },
                    "required": [
                      "type",
                      "value"
                    ],
                    "type": "object"
                  },
                  "object_entity_id": {
                    "type": "string"
                  },
                  "object_revision": {
                    "type": "integer"
                  },
                  "predicate": {
                    "type": "string"
                  },
                  "source_span_ids": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "subject_id": {
                    "type": "string"
                  },
                  "subject_revision": {
                    "type": "integer"
                  }
                },
                "required": [
                  "claim_id",
                  "effective_from",
                  "evidence_class",
                  "predicate",
                  "source_span_ids",
                  "subject_id"
                ],
                "type": "object"
              },
              "expected_answer": {
                "maxLength": 8000,
                "type": "string"
              },
              "expected_base_revision": {
                "type": "integer"
              },
              "question": {
                "maxLength": 4000,
                "type": "string"
              },
              "reason": {
                "maxLength": 2000,
                "type": "string"
              }
            },
            "required": [
              "expected_answer",
              "expected_base_revision",
              "question",
              "reason"
            ],
            "type": "object"
          },
          "content_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "missing_requirements": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "original": {
            "additionalProperties": false,
            "properties": {
              "answer": {
                "maxLength": 8000,
                "type": "string"
              },
              "available": {
                "type": "boolean"
              },
              "investigation_rationale": {
                "maxLength": 2000,
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "outcome_reasons": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "outcome_status": {
                "type": "string"
              },
              "provenance": {
                "additionalProperties": false,
                "properties": {
                  "artifact_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "artifact_sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "process_snapshot_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "run_id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "run_refs_sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "terminal_sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [],
                "type": "object"
              },
              "question": {
                "maxLength": 4000,
                "type": "string"
              }
            },
            "required": [
              "available",
              "kind",
              "provenance"
            ],
            "type": "object"
          },
          "proposer_issuer": {
            "type": "string"
          },
          "proposer_subject": {
            "type": "string"
          },
          "published_snapshot_id": {
            "format": "uuid",
            "type": "string"
          },
          "review": {
            "additionalProperties": false,
            "properties": {
              "actor_issuer": {
                "type": "string"
              },
              "actor_subject": {
                "type": "string"
              },
              "canonical_review_id": {
                "format": "uuid",
                "type": "string"
              },
              "claim_id": {
                "format": "uuid",
                "type": "string"
              },
              "claim_revision": {
                "type": "integer"
              },
              "created_at": {
                "format": "date-time",
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "review_id": {
                "format": "uuid",
                "type": "string"
              },
              "verdict": {
                "type": "string"
              }
            },
            "required": [
              "actor_issuer",
              "actor_subject",
              "created_at",
              "reason",
              "review_id",
              "verdict"
            ],
            "type": "object"
          },
          "review_state": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "site_id": {
            "format": "uuid",
            "type": "string"
          },
          "source_feedback_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "candidate_id",
          "content",
          "content_sha256",
          "created_at",
          "kind",
          "missing_requirements",
          "original",
          "proposer_issuer",
          "proposer_subject",
          "review_state",
          "revision",
          "site_id",
          "source_feedback_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next_cursor": {
      "type": "string"
    }
  },
  "required": [
    "candidates"
  ],
  "type": "object"
}
