{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "inventory_id": {
      "format": "uuid",
      "type": "string"
    },
    "process_id": {
      "format": "uuid",
      "type": "string"
    },
    "role": {
      "enum": [
        "owner",
        "supervisor",
        "operator"
      ],
      "type": "string"
    }
  },
  "required": [
    "role"
  ],
  "type": "object"
}
