                "required": [
                  "closed_downtime_seconds",
                  "completion_record_id",
                  "completion_state",
                  "completion_values_as_recorded",
                  "corrections",
                  "cycle_time",
                  "downtime",
                  "good_quantity",
                  "last_event_at",
                  "late_record_ids",
                  "material_exceptions",
                  "over_production",
                  "quality",
                  "quantity_record_ids",
                  "reject_quantity",
                  "remaining_quantity"
