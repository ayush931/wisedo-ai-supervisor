                      "holds_as_recorded": {
                        "type": "integer"
                      },
                      "measurement_count": {
                        "type": "integer"
                      },
                      "measurement_record_ids": {
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "rejects_as_recorded": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "accepts_as_recorded",
                      "dispositions_as_recorded",
                      "holds_as_recorded",
                      "measurement_count",
                      "measurement_record_ids",
                      "rejects_as_recorded"
                    ],
                    "type": "object"
                  },
                  "quantity_record_ids": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "reject_quantity": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "remaining_quantity": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
