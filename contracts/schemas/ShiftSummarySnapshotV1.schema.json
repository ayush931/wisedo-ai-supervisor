                "items": {
                  "enum": [
                    "CORRECTIONS_PRESENT",
                    "INVALID_RECORDED_VALUE",
                    "LATE_ENTRIES",
                    "NOT_IN_APPROVED_PLAN",
                    "NO_CYCLE_TIME_RECORDS",
                    "NO_QUANTITY_RECORDS",
                    "NO_RECORDS",
                    "OVER_PRODUCTION",
                    "QUANTITY_OVERFLOW",
                    "RECORDED_AFTER_RUN_END",
                    "SHIFT_IN_PROGRESS",
                    "STALE_INPUT",
                    "SUPERSEDED_PLAN_BINDING",
