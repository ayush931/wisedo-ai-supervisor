                          "enum": [
                            "acknowledged",
                            "started",
                            "paused",
                            "blocked",
                            "resumed",
                            "quantity",
                            "cycle_time",
                            "quality_measurement",
                            "quality_disposition_recorded",
                            "material_exception",
                            "completion_evidence",
                            "note"
