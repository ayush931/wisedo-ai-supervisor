        "ends_at": {
          "format": "date-time",
          "type": "string"
        },
        "formula_version": {
          "type": "integer"
        },
        "jobs": {
          "additionalProperties": false,
          "properties": {
            "completed": {
              "type": "integer"
            },
            "in_progress": {
              "type": "integer"
            },
            "not_started": {
              "type": "integer"
            },
            "planned": {
              "type": "integer"
            },
            "remaining": {
              "type": "integer"
            },
            "unknown": {
              "type": "integer"
            }
          },
          "required": [
            "completed",
            "in_progress",
            "not_started",
            "planned",
            "remaining",
            "unknown"
          ],
          "type": "object"
