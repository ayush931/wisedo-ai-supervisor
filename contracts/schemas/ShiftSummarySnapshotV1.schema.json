        "ends_at",
        "formula_version",
        "jobs",
        "line_id",
        "notes",
        "plan_id",
        "plan_revision",
        "plan_revision_digest",
        "policy",
        "readiness",
        "reasons",
        "schema_version",
        "shift_ended",
        "source_record_count",
        "starts_at",
        "stations"
      ],
      "type": "object"
    }
