                        },
                        "material_code": {
                          "type": "string"
                        },
                        "record_id": {
                          "type": "string"
                        },
                        "recorded_by": {
                          "additionalProperties": false,
                          "properties": {
                            "issuer": {
                              "type": "string"
                            },
                            "subject": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "issuer",
                            "subject"
                          ],
                          "type": "object"
                        }
                      },
                      "required": [
                        "event_at",
                        "issue",
                        "material_code",
                        "record_id",
                        "recorded_by"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "over_production": {
                    "type": "boolean"
                  },
                  "quality": {
                    "additionalProperties": false,
                    "properties": {
                      "accepts_as_recorded": {
                        "type": "integer"
                      },
                      "dispositions_as_recorded": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "comment": {
                              "type": "string"
                            },
                            "disposition": {
                              "enum": [
                                "accept",
                                "hold",
                                "reject"
