{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "next_cursor": {
      "type": "string"
    },
    "summaries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_payload_digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "type": "string"
          },
          "generated_by": {
            "additionalProperties": false,
            "properties": {
              "issuer": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              }
            },
            "required": [
              "issuer",
              "subject"
            ],
            "type": "object"
          },
          "plan_revision": {
            "type": "integer"
          },
          "readiness": {
            "enum": [
              "INVALID",
              "LIMITED",
              "NOT_READY",
              "READY"
            ],
            "type": "string"
          },
          "revision": {
            "type": "integer"
          }
        },
        "required": [
          "canonical_payload_digest",
          "generated_at",
          "generated_by",
          "plan_revision",
          "readiness",
          "revision"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "summaries"
  ],
  "type": "object"
}
