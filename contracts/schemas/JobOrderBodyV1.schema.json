{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "dependentRequired": {
    "item_id": [
      "routing_id",
      "step_number"
    ],
    "routing_id": [
      "item_id",
      "step_number"
    ],
    "step_number": [
      "item_id",
      "routing_id"
    ]
  },
  "properties": {
    "due_at": {
      "type": "string"
    },
    "fields": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "choices": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "label",
          "name",
          "required"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "instruction_document_id": {
      "type": "string"
    },
    "instruction_revision": {
      "type": "integer"
    },
    "instruction_sha256": {
      "type": "string"
    },
    "item_code": {
      "type": "string"
    },
    "item_id": {
      "description": "Catalog item UUID for the routing. item_code remains the human product code or name.",
      "format": "uuid",
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "order_id": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "routing_id": {
      "description": "Optional current master-data routing. Supply item_id, routing_id and step_number together, or omit all three.",
      "format": "uuid",
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "step_number": {
      "minimum": 1,
      "type": "integer"
    },
    "target_cycle_time_seconds": {
      "type": "string"
    },
    "target_quantity": {
      "type": "integer"
    },
    "template": {
      "type": "string"
    }
  },
  "required": [
    "fields",
    "instruction_document_id",
    "instruction_revision",
    "instruction_sha256",
    "item_code",
    "operation_id",
    "order_id",
    "schema_version",
    "target_quantity",
    "template"
  ],
  "type": "object"
}
