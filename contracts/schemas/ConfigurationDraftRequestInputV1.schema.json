{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kinds": {
      "items": {
        "enum": [
          "item",
          "line",
          "routing",
          "workstation_profile"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "session_id": {
      "format": "uuid",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 20,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "kinds",
    "session_id",
    "source_ids"
  ],
  "type": "object"
}
