{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "path": {
      "type": "string"
    },
    "reason": {
      "enum": [
        "ACCESS_EPOCH_CHANGED",
        "FIELD_CHANGED",
        "SOURCE_REVOKED"
      ],
      "type": "string"
    },
    "span_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "path",
    "reason",
    "span_id"
  ],
  "type": "object"
}
