                "properties": {
                  "asset_id": {
                    "type": "string"
                  },
                  "good_units": {
                    "type": "string"
                  },
                  "interval_end": {
                    "type": "string"
                  },
                  "interval_start": {
                    "type": "string"
                  },
                  "order_id": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  }
