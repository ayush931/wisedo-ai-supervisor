                "type": "integer"
              },
              "source_sequence": {
                "type": "integer"
              }
            },
            "required": [
              "event_at",
              "external_key",
              "kind",
              "payload",
              "revision",
              "source_sequence"
            ],
            "type": "object"
          },
          {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "additionalProperties": false,
            "properties": {
              "asset_external_key": {
                "type": "string"
              },
              "event_at": {
                "format": "date-time",
                "type": "string"
              },
              "external_key": {
                "type": "string"
              },
