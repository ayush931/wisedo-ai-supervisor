{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_issuer": {
      "type": "string"
    },
    "actor_subject": {
      "type": "string"
    },
    "authenticated_at": {
      "format": "date-time",
      "type": "string"
    },
    "config_sha256": {
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_revision": {
      "type": "integer"
    },
    "decision_id": {
      "type": "string"
    },
    "mapping_revision": {
      "type": "integer"
    },
    "mapping_sha256": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "source_revision": {
      "type": "integer"
    },
    "verdict": {
      "enum": [
        "approved",
        "rejected"
      ],
      "type": "string"
    }
  },
  "required": [
    "actor_issuer",
    "actor_subject",
    "authenticated_at",
    "config_sha256",
    "created_at",
    "current_revision",
    "decision_id",
    "mapping_revision",
    "mapping_sha256",
    "reason",
    "revision",
    "source_revision",
    "verdict"
  ],
  "type": "object"
}
