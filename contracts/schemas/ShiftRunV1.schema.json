{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_by": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "issuer",
            "subject"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_plan_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "handover_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_summary_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_id": {
      "type": "string"
    },
    "plan_state_revision": {
      "type": "integer"
    },
    "replayed": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "integer"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_by": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "issuer",
            "subject"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_plan_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "ended",
        "planned",
        "started"
      ],
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "canonical_payload_digest": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "revision": {
              "type": "integer"
            }
          },
          "required": [
            "canonical_payload_digest",
            "revision"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary_revised": {
      "type": "boolean"
    }
  },
  "required": [
    "ended_at",
    "ended_by",
    "ended_plan_revision",
    "handover_revision",
    "latest_summary_revision",
    "plan_id",
    "plan_state_revision",
    "replayed",
    "schema_version",
    "started_at",
    "started_by",
    "started_plan_revision",
    "state",
    "summary",
    "summary_revised"
  ],
  "type": "object"
}
