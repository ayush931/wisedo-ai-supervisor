{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizes_release": {
      "type": "boolean"
    },
    "comment": {
      "type": "string"
    },
    "corrects_record_id": {
      "type": "string"
    },
    "cycle_time_seconds": {
      "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "accept",
        "hold",
        "reject"
      ],
      "type": "string"
    },
    "event_at": {
      "format": "date-time",
      "type": "string"
    },
    "good_quantity": {
      "type": "integer"
    },
    "job_order_id": {
      "type": "string"
    },
    "job_order_revision": {
      "type": "integer"
    },
    "kind": {
      "enum": [
        "acknowledged",
        "started",
        "paused",
        "blocked",
        "resumed",
        "quantity",
        "cycle_time",
        "quality_measurement",
        "quality_disposition_recorded",
        "material_exception",
        "completion_evidence",
        "note"
      ],
      "type": "string"
    },
    "material_code": {
      "type": "string"
    },
    "material_issue": {
      "enum": [
        "damaged",
        "other",
        "shortage",
        "wrong_material"
      ],
      "type": "string"
    },
    "reject_quantity": {
      "type": "integer"
    },
    "schema_version": {
      "type": "integer"
    },
    "values": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "workstation_id": {
      "type": "string"
    }
  },
  "required": [
    "event_at",
    "job_order_id",
    "job_order_revision",
    "kind",
    "schema_version",
    "workstation_id"
  ],
  "type": "object"
}
