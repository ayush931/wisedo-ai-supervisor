{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "challenged": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer"
        },
        "source_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "source_id"
      ],
      "type": "object"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "kind": {
      "enum": [
        "correction",
        "observation",
        "usefulness"
      ],
      "type": "string"
    },
    "observation_end": {
      "format": "date-time",
      "type": "string"
    },
    "observation_start": {
      "format": "date-time",
      "type": "string"
    },
    "proposal_id": {
      "format": "uuid",
      "type": "string"
    },
    "proposed_correction": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "additionalProperties": false,
          "properties": {
            "claim_id": {
              "type": "string"
            },
            "confidence": {
              "type": "string"
            },
            "effective_from": {
              "type": "string"
            },
            "effective_to": {
              "type": "string"
            },
            "evidence_class": {
              "type": "string"
            },
            "extractor": {
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string"
                },
                "prompt_sha256": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "model",
                "prompt_sha256",
                "provider",
                "version"
              ],
              "type": "object"
            },
            "literal": {
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "value": {
                  "description": "Any JSON value"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "type": "object"
            },
            "object_entity_id": {
              "type": "string"
            },
            "object_revision": {
              "type": "integer"
            },
            "predicate": {
              "type": "string"
            },
            "source_span_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "subject_id": {
              "type": "string"
            },
            "subject_revision": {
              "type": "integer"
            }
          },
          "required": [
            "claim_id",
            "effective_from",
            "evidence_class",
            "predicate",
            "source_span_ids",
            "subject_id"
          ],
          "type": "object"
        },
        "expected_answer": {
          "maxLength": 8000,
          "type": "string"
        },
        "expected_base_revision": {
          "type": "integer"
        },
        "question": {
          "maxLength": 4000,
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "expected_answer",
        "expected_base_revision",
        "question",
        "reason"
      ],
      "type": "object"
    },
    "reason": {
      "maxLength": 2000,
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "type": "string"
        },
        "claim_id": {
          "format": "uuid",
          "type": "string"
        },
        "claim_revision": {
          "type": "integer"
        },
        "conversation_id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "answer",
            "investigation",
            "case",
            "claim",
            "mapping",
            "task"
          ],
          "type": "string"
        },
        "mapping_revision": {
          "type": "integer"
        },
        "message_id": {
          "format": "uuid",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_id": {
          "format": "uuid",
          "type": "string"
        },
        "task_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "supersedes_feedback_id": {
      "format": "uuid",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "helpful",
        "not_applicable",
        "uncertain",
        "unhelpful"
      ],
      "type": "string"
    }
  },
  "required": [
    "evidence_ids",
    "kind",
    "reason",
    "schema_version",
    "subject",
    "verdict"
  ],
  "type": "object"
}
