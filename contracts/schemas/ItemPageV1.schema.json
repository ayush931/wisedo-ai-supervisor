{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "additionalProperties": false,
            "properties": {
              "active": {
                "type": "boolean"
              },
              "display_name": {
                "maxLength": 128,
                "type": "string"
              },
              "schema_version": {
                "type": "integer"
              },
              "unit": {
                "enum": [
                  "count"
                ],
                "type": "string"
              }
            },
            "required": [
              "active",
              "display_name",
              "schema_version",
              "unit"
            ],
            "type": "object"
          },
          "current_revision": {
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "body",
          "current_revision",
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next_cursor": {
      "type": "string"
    }
  },
  "required": [
    "items"
  ],
  "type": "object"
}
