  "required": [
    "as_of",
    "claims",
    "direction",
    "entities",
    "hops",
    "inventory_revision",
    "max_claims",
    "max_entities",
    "predicates",
    "roots",
    "schema_version",
    "sha256",
    "snapshot_id",
    "truncated"
  ],
  "type": "object"
}
