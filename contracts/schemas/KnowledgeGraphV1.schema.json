      "items": {
        "additionalProperties": false,
        "properties": {
          "authority": {
            "additionalProperties": false,
            "properties": {
              "decision_id": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              },
              "source_id": {
                "type": "string"
              },
              "source_revision": {
                "type": "integer"
              }
            },
            "required": [
              "decision_id",
              "revision",
              "source_id",
              "source_revision"
            ],
            "type": "object"
          },
          "claim_id": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          },
          "effective_from": {
            "type": "string"
          },
          "effective_to": {
            "type": "string"
          },
          "evidence_class": {
            "type": "string"
          },
          "extractor": {
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "prompt_sha256": {
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "model",
              "prompt_sha256",
              "provider",
              "version"
            ],
            "type": "object"
          },
          "literal": {
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "value": {
                "description": "Any JSON value"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          "object_entity_id": {
            "type": "string"
          },
          "object_revision": {
            "type": "integer"
          },
          "predicate": {
            "type": "string"
          },
          "resolution_refs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "conflict_id": {
                  "type": "string"
