          "display_name",
          "entity_id",
          "revision",
          "source_id",
          "source_revision",
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hops": {
      "type": "integer"
    },
    "inventory_revision": {
      "type": "integer"
    },
    "max_claims": {
      "type": "integer"
    },
    "max_entities": {
      "type": "integer"
    },
    "predicates": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "roots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_version": {
      "type": "integer"
    },
    "sha256": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
