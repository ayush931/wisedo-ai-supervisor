                  "type": "string"
                },
                "revision": {
                  "type": "integer"
                }
              },
              "required": [
                "conflict_id",
                "resolution_id",
                "revision"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "review_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "source_span_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "subject_id": {
            "type": "string"
          },
          "subject_revision": {
            "type": "integer"
          }
        },
        "required": [
          "authority",
          "claim_id",
          "effective_from",
          "evidence_class",
          "predicate",
          "resolution_refs",
          "review_id",
          "revision",
          "source_span_ids",
          "subject_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "direction": {
      "type": "string"
    },
    "entities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "asset_kind": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "source_id": {
            "type": "string"
          },
          "source_revision": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          }
