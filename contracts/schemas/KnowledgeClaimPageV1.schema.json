{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "corroboration": {
            "additionalProperties": false,
            "properties": {
              "authoritative": {
                "type": "boolean"
              },
              "independent_groups": {
                "type": "integer"
              },
              "model_extracted_sources": {
                "type": "integer"
              }
            },
            "required": [
              "authoritative",
              "independent_groups",
              "model_extracted_sources"
            ],
            "type": "object"
          },
          "current_revision": {
            "type": "integer"
          },
          "object_entity_id": {
            "type": "string"
          },
          "predicate": {
            "type": "string"
          },
          "review_state": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "sources_current": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "subject_id": {
            "type": "string"
          }
        },
        "required": [
          "claim_id",
          "corroboration",
          "current_revision",
          "predicate",
          "review_state",
          "revision",
          "sources_current",
          "state",
          "subject_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "next_cursor": {
      "type": "string"
    }
  },
  "required": [
    "claims"
  ],
  "type": "object"
}
