{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_issuer": {
      "type": "string"
    },
    "actor_subject": {
      "type": "string"
    },
    "claim_id": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "corroboration": {
      "additionalProperties": false,
      "properties": {
        "authoritative": {
          "type": "boolean"
        },
        "independent_groups": {
          "type": "integer"
        },
        "model_extracted_sources": {
          "type": "integer"
        }
      },
      "required": [
        "authoritative",
        "independent_groups",
        "model_extracted_sources"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_revision": {
      "type": "integer"
    },
    "effective_from": {
      "type": "string"
    },
    "effective_to": {
      "type": "string"
    },
    "evidence_class": {
      "type": "string"
    },
    "extractor": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "prompt_sha256": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "model",
        "prompt_sha256",
        "provider",
        "version"
      ],
      "type": "object"
    },
    "literal": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "description": "Any JSON value"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "type": "object"
    },
    "object_entity_id": {
      "type": "string"
    },
    "object_revision": {
      "type": "integer"
    },
    "predicate": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "source_span_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "sources_current": {
      "type": "boolean"
    },
    "state": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_revision": {
      "type": "integer"
    }
  },
  "required": [
    "actor_issuer",
    "actor_subject",
    "claim_id",
    "corroboration",
    "created_at",
    "current_revision",
    "effective_from",
    "evidence_class",
    "predicate",
    "revision",
    "source_span_ids",
    "sources_current",
    "state",
    "subject_id"
  ],
  "type": "object"
}
