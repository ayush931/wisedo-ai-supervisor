                      },
                      "type": "array"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "unit": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "label",
                    "name",
                    "required"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "instruction_document_id": {
                "type": "string"
              },
              "instruction_revision": {
                "type": "integer"
              },
              "instruction_sha256": {
                "type": "string"
              },
              "item_code": {
                "type": "string"
              },
              "item_id": {
                "format": "uuid",
                "type": "string"
              },
              "operation_id": {
                "type": "string"
              },
              "order_id": {
                "type": "string"
              },
              "priority": {
                "type": "integer"
              },
              "routing_id": {
                "format": "uuid",
                "type": "string"
              },
              "schema_version": {
                "type": "integer"
              },
              "step_number": {
                "type": "integer"
              },
              "target_cycle_time_seconds": {
                "type": "string"
