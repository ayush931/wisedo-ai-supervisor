# LOCAL REHEARSAL ONLY: not a production configuration (see LOCAL-ONLY.md in the release bundle).
# Go Supervisor local development template.
# Copy to .env and replace every placeholder before starting services.
# Never commit .env or real credentials.

# deploy/supervisor/compose.yml prerequisites
POSTGRES_ADMIN_PASSWORD=replace-local-admin-password
SUPERVISOR_MIGRATION_PASSWORD=replace-local-migration-password
SUPERVISOR_RUNTIME_PASSWORD=replace-local-runtime-password
KEYCLOAK_DB_PASSWORD=replace-local-keycloak-db-password
TEMPORAL_DB_PASSWORD=replace-local-temporal-db-password
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=replace-local-keycloak-admin-password

# Local service ports and isolated network
SUPERVISOR_PG_PORT=55477
SUPERVISOR_IDP_PORT=58077
SUPERVISOR_TEMPORAL_PORT=57277
SUPERVISOR_LOCAL_SUBNET=10.253.77.0/24

# Host-run Go Supervisor configuration
SUPERVISOR_ENVIRONMENT=local
SUPERVISOR_DATABASE_URL=postgresql://supervisor_runtime:replace-runtime-password@127.0.0.1:55477/supervisor
SUPERVISOR_MIGRATION_URL=postgresql://supervisor_migrator:replace-migration-password@127.0.0.1:55477/supervisor
SUPERVISOR_PUBLIC_ORIGIN=http://127.0.0.1:58176
SUPERVISOR_LISTEN_ADDRESS=127.0.0.1:58176
SUPERVISOR_WEB_DIST=web/dist
SUPERVISOR_OIDC_ISSUER=http://127.0.0.1:58077/realms/supervisor-local
SUPERVISOR_OIDC_CLIENT_ID=supervisor
SUPERVISOR_OIDC_CLIENT_SECRET=replace-local-client-secret
SUPERVISOR_TEMPORAL_ADDRESS=127.0.0.1:57277
SUPERVISOR_TEMPORAL_NAMESPACE=default
SUPERVISOR_TEMPORAL_TASK_QUEUE=supervisor-foundation-go
SUPERVISOR_TEMPORAL_TLS=false
# Optional worker allowlist; unset or [] discovers every active tenant.
SUPERVISOR_RELAY_TENANT_IDS=[]

# WIS-275 agent runtime. Leave SUPERVISOR_AGENT_PROVIDER unset to disable it (the rollback).
# local = a pinned local OpenAI-compatible model service, no cloud fallback;
# fixture = the deterministic test adapter, refused when SUPERVISOR_ENVIRONMENT=production.
SUPERVISOR_AGENT_PROVIDER=
# http(s) host and port only: a loopback/private IP literal or a name in the allowlist below.
SUPERVISOR_AGENT_BASE_URL=http://127.0.0.1:8000
# Comma-separated host names allowed in the base URL (IP literals need no entry).
SUPERVISOR_AGENT_ENDPOINT_ALLOWLIST=
# Required when enabled: the exact IP or IP:port set the dialer may connect to. A resolved
# address outside it is refused even when private, so DNS cannot move calls to another service.
SUPERVISOR_AGENT_ENDPOINT_ADDRS=127.0.0.1:8000
# Exact model ID served at /v1/models, and an opaque pin (for example a weights digest).
SUPERVISOR_AGENT_MODEL=
SUPERVISOR_AGENT_MODEL_REVISION=
# Optional path to a file holding the endpoint key; the key itself never goes in this file.
SUPERVISOR_AGENT_API_KEY_FILE=
SUPERVISOR_AGENT_TIMEOUT=30s
SUPERVISOR_AGENT_MAX_CONCURRENT=2
SUPERVISOR_AGENT_MAX_QUEUED=8
# Running OCR scan pages one tenant may hold (WIS-715); more is 503 SCAN_QUEUE_FULL. 20 to 10000.
# A page still running after one hour is treated as lost and stops counting.
SUPERVISOR_AGENT_SCAN_TENANT_CAP=40
# Investigation mode; disabled until a site policy enables it.
SUPERVISOR_AGENT_MODE_ENABLED=false
# Approved-task execution (WIS-277): consume approved proposals into internal tasks.
SUPERVISOR_TASK_EXECUTION_ENABLED=false

# Optional disposable local fixture identity
SUPERVISOR_LOCAL_KEYCLOAK=http://127.0.0.1:58077
SUPERVISOR_LOCAL_ADMIN=local-admin
SUPERVISOR_LOCAL_ADMIN_PASSWORD=replace-local-keycloak-admin-password
SUPERVISOR_LOCAL_USER_PASSWORD=replace-local-user-password
SUPERVISOR_TEST_ADMIN_URL=postgresql://postgres:replace-local-admin-password@127.0.0.1:55477/postgres
